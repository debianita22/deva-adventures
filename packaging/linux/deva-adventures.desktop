TryExec=deva-adventures
Exec=deva-adventures --fullscreen
Terminal=false
Categories=Game;KidsGame;
Keywords=Deva;children;kids;bambini;giochi;storie;
StartupNotify=true
StartupWMClass=deva-adventures
Actions=window;

[Desktop Action window]
Name=Play in a window
Name[it]=Gioca in una finestra

/* Deva's Awesome Adventures - the resources of deva-adventures.exe: icon, manifest, version (1.2).
   build/<dir>/deva-adventures.rc is made from this file with the version of src/common.h. */
#include <windows.h>

1 ICON "packaging/windows/deva-adventures.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSIONC@,0
PRODUCTVERSION @VERSIONC@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004b0"
        BEGIN
            VALUE "CompanyName", "Deva's Awesome Adventures"
            VALUE "FileDescription", "Deva's Awesome Adventures"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "deva-adventures"
            VALUE "LegalCopyright", "Licenza MIT"
            VALUE "OriginalFilename", "deva-adventures.exe"
            VALUE "ProductName", "Deva's Awesome Adventures"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x410, 1200
    END
END
